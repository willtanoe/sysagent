{
  "name": "aster-fleet",
  "version": "1.0.0",
  "description": "Aster Fleet Manager — Hardened Hub + Multi-Node SRE Agent via Telegram",
  "main": "dist/hub/index.js",
  "scripts": {
    "build": "tsc",
    "start:hub": "node dist/hub/index.js",
    "start:node": "node dist/node/index.js",
    "hub": "tsx src/hub/index.ts",
    "node": "tsx src/node/index.ts",
    "node:junin": "NODE_ID=junin tsx src/node/index.ts",
    "node:fubuku": "NODE_ID=fubuku tsx src/node/index.ts",
    "test": "npm run build && node tests/poc-smoke.js"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^16.4.5",
    "grammy": "^1.36.0",
    "openai": "^4.78.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.3"
  }
}
