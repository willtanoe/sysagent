{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "instructions/INSTRUCTIONS.md",
    "skills/safety-guard/SKILL.md",
    "skills/agent-security-hardening/SKILL.md",
    "skills/terminal-ops/SKILL.md",
    "skills/production-audit/SKILL.md",
    "skills/security-review/SKILL.md",
    "skills/deployment-patterns/SKILL.md",
    "skills/docker-patterns/SKILL.md",
    "skills/network-interface-health/SKILL.md",
    "skills/verification-loop/SKILL.md",
    "skills/strategic-compact/SKILL.md",
    "skills/coding-standards/SKILL.md"
  ],
  "plugin": [
    "./plugins"
  ],
  "skills": {
    "paths": [
      "./skills",
      "../skills"
    ]
  },
  "agent": {
    "build": {
      "description": "Primary SRE & coding agent for server operations and development work",
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "changed-files": true
      }
    },
    "planner": {
      "description": "Expert planning specialist for complex infrastructure changes, features, and refactoring.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/planner.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "architect": {
      "description": "Software and infrastructure architecture specialist for system design, scalability, and technical decision-making.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/architect.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "code-reviewer": {
      "description": "Expert code review specialist. Reviews code and configs for quality, security, and maintainability.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/code-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist for server configs, secrets, auth, and code.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/security-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "network-config-reviewer": {
      "description": "Reviews network, router, switch, and Linux firewall/routing configurations for security and operational guardrails.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/network-config-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "database-reviewer": {
      "description": "Database specialist (PostgreSQL, MySQL, Redis) for query optimization, schema design, security, and performance.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/database-reviewer.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology and 80%+ coverage.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/tdd-guide.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Fixes build/type errors with minimal diffs.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/build-error-resolver.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/doc-updater.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/refactor-cleaner.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "harness-optimizer": {
      "description": "Analyze and improve the local agent harness configuration for reliability, cost, and throughput.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/harness-optimizer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "edit": true
      }
    },
    "loop-operator": {
      "description": "Operate autonomous agent loops, monitor progress, and intervene safely when loops stall.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/loop-operator.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "edit": true
      }
    },
    "go-reviewer": {
      "description": "Expert Go code reviewer.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/go-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "python-reviewer": {
      "description": "Expert Python code reviewer.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/python-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "rust-reviewer": {
      "description": "Expert Rust code reviewer.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/rust-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    }
  },
  "command": {
    "plan": {
      "description": "Create a detailed implementation or operational plan",
      "template": "{file:commands/plan.md}\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run 6-phase verification loop",
      "template": "{file:commands/verify.md}\n\n$ARGUMENTS"
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:commands/security.md}\n\n$ARGUMENTS"
    },
    "security-scan": {
      "description": "Scan repository and configs for security vulnerabilities",
      "template": "{file:commands/security-scan.md}\n\n$ARGUMENTS"
    },
    "code-review": {
      "description": "Review code and configuration changes for quality and security",
      "template": "{file:commands/code-review.md}\n\n$ARGUMENTS"
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:commands/build-fix.md}\n\n$ARGUMENTS"
    },
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:commands/tdd.md}\n\n$ARGUMENTS"
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:commands/refactor-clean.md}\n\n$ARGUMENTS"
    },
    "orchestrate": {
      "description": "Orchestrate structured multi-step workflow",
      "template": "{file:commands/orchestrate.md}\n\n$ARGUMENTS"
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:commands/eval.md}\n\n$ARGUMENTS"
    },
    "harness-audit": {
      "description": "Audit agent harness security and configuration",
      "template": "{file:commands/harness-audit.md}\n\n$ARGUMENTS"
    },
    "pm2": {
      "description": "Analyze project and generate PM2 service management commands",
      "template": "{file:commands/pm2.md}\n\n$ARGUMENTS"
    },
    "update-docs": {
      "description": "Update documentation",
      "template": "{file:commands/update-docs.md}\n\n$ARGUMENTS"
    }
  },
  "permission": {
    "mcp_*": "ask"
  }
}
