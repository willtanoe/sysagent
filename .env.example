# ============================================================================
# 1. KONFIGURASI ASTER HUB (Server Koordinasi Pusat & Bot Telegram)
# ============================================================================
HUB_HOST=0.0.0.0
HUB_PORT=8765

# Token autentikasi master untuk node yang terhubung (wajib diganti dengan string acak >= 32 karakter)
HUB_TOKEN=ganti-dengan-token-acak-minimal-32-karakter

# Opsional: Token spesifik per-node (format: nodeA:tokenA,nodeB:tokenB)
# Jika diisi untuk suatu node, maka node tersebut wajib memakai token spesifiknya.
NODE_TOKENS=

# Opsional: Native TLS untuk WSS langsung tanpa reverse proxy
TLS_CERT_PATH=
TLS_KEY_PATH=

# Telegram Bot (Kosongkan TELEGRAM_BOT_TOKEN jika Hub hanya dijalankan dalam mode headless)
TELEGRAM_BOT_TOKEN=
BOT_NAME=aster_fleet_bot
# Daftar Telegram User ID admin yang diizinkan (pisah koma, wajib diisi di produksi)
ALLOWED_USER_ID=
# Opsional: Kunci hanya pada Chat ID tertentu (mis. DM atau grup ops internal)
ALLOWED_CHAT_ID=
# Opsional: Kunci bot hanya merespons di 1 Topic / Thread tertentu pada grup Forum (bisa juga diset via /topic di Telegram)
# Format: angka topic_id (mis. 42) atau spesifik per-grup chatId:topicId (mis. -100123456789:42)
ALLOWED_TOPIC_ID=
# Opsional: Tampilkan daftar popup autocomplete '/' di grup (set false jika hanya ingin popup '/' muncul di DM)
BOT_GROUP_COMMANDS=true

# Lokasi penyimpanan state Hub (node aktif, riwayat chat, usage)
HUB_STATE_FILE=/var/lib/aster-hub/hub-state.json
# Kirim notifikasi saat node online/terputus (true/false)
NOTIFY_NODE_EVENTS=true

# Embedded OpenCode Agent di Hub (aktif otomatis agar bisa ngobrol dengan OpenCode di Hub & koordinasi lintas node)
HUB_EMBED_NODE=true
HUB_NODE_ID=hub
HUB_ENGINE=opencode
# Opsional: lokasi file audit embedded Hub (default: <direktori HUB_STATE_FILE>/audit-<HUB_NODE_ID>.jsonl)
HUB_AUDIT_PATH=
# Opsional: port & direktori data daemon OpenCode milik embedded Hub
# (default: port acak di 127.0.0.1 dan <direktori HUB_STATE_FILE>/opencode-<HUB_NODE_ID>)
# Jika kosong, Hub memakai OPENCODE_PORT / OPENCODE_DATA_DIR sebagai cadangan.
HUB_OPENCODE_PORT=
HUB_OPENCODE_DATA_DIR=

# Auto-update dari Git remote saat ada commit baru (berlaku di Hub maupun Node)
# Set AUTO_UPDATE=false jika hanya ingin update manual lewat command /update di Telegram
AUTO_UPDATE=true
AUTO_UPDATE_INTERVAL_MS=120000
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_BRANCH=

# ============================================================================
# 2. KONFIGURASI ASTER NODE AGENT (Dijalankan di tiap Server / VPS Target)
# ============================================================================
NODE_ID=hongyun
HUB_URL=wss://hub.internal.kantor.id:8765
# Gunakan NODE_TOKEN jika memakai token per-node, atau HUB_TOKEN jika memakai token master
NODE_TOKEN=
AUDIT_PATH=/var/lib/aster-node/audit-hongyun.jsonl

# Opsional: Custom CA certificate jika Hub memakai self-signed TLS internal kantor
TLS_CA_PATH=
TLS_REJECT_UNAUTHORIZED=true

# Opsional: Password sudo jika node berjalan sebagai non-root tanpa NOPASSWD.
# Jika kosong, sudo dijalankan dengan flag -n (fail-fast, tidak pernah menggantung).
SUDO_PASSWORD=

# Batas waktu & rate limit eksekusi di node
SHELL_TIMEOUT_MS=120000
PACKAGE_TIMEOUT_MS=900000
APPROVAL_TIMEOUT_MS=300000
MAX_COMMANDS_PER_MINUTE=30
HEARTBEAT_INTERVAL_MS=15000

# Daftar unit systemd untuk ditampilkan di /status (kosong = deteksi otomatis)
STATUS_SERVICES=

# Alert proaktif kesehatan node (dikirim ke Telegram admin melalui Hub)
ALERT_INTERVAL_MS=300000
ALERT_COOLDOWN_MS=1800000
ALERT_DISK_PCT=90
ALERT_MEM_PCT=92
ALERT_IGNORE_UNITS=

# ============================================================================
# 3. PILIHAN ENGINE AI DI NODE: opencode (Bundled, Disarankan) | local
# ============================================================================
# Engine: opencode (disarankan, memakai @opencode/cli bawaan & ECC skills)
#         local    (memakai agent bawaan dengan endpoint OpenAI-compatible GATEWAY_*)
ENGINE=opencode

# Konfigurasi OpenCode (ketika ENGINE=opencode)
# Format model: provider/model (contoh model free: opencode/glm-5.3-flash-free)
# Atau custom gateway: asteria/reflection/Beam-1.0-501B-A23B
OPENCODE_MODEL=opencode/glm-5.3-flash-free
OPENCODE_URL=
OPENCODE_PASSWORD=
OPENCODE_BIN=
OPENCODE_PORT=
OPENCODE_DATA_DIR=
OPENCODE_DIR=/
OPENCODE_TIMEOUT_MS=900000
OPENCODE_POLL_MS=700

# Profil hook plugin ECC pada instance OpenCode: minimal | standard (default) | strict
ECC_HOOK_PROFILE=standard
# Opsional: daftar ID hook ECC yang dinonaktifkan (pisah koma)
ECC_DISABLED_HOOKS=

# Konfigurasi Custom OpenAI-Compatible Gateway untuk OpenCode & Local Engine
# Jika diisi, OpenCode akan otomatis menginjeksi provider custom ini ke instance sandbox-nya,
# tanpa perlu file ~/.config/opencode/opencode.json maupun environment HOME di systemd!
# Alias yang juga dibaca: GATEWAY_BASE_URL / OPENAI_BASE_URL (URL), OPENAI_API_KEY (kunci),
# OPENAI_MODEL (model Hub untuk ENGINE=local), serta OPENCODE_GATEWAY_URL / OPENCODE_GATEWAY_API_KEY
# khusus untuk injeksi provider OpenCode.
GATEWAY_URL=https://gateway.asteria.im/v1
GATEWAY_API_KEY=
MODEL_NAME=
MODEL_FALLBACK=
AI_TIMEOUT_MS=90000
MAX_TOOL_LOOPS=12
MAX_READ_ONLY_STEPS=6
