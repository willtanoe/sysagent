# Aster Hub Fleet Configuration
HUB_PORT=8765
HUB_TOKEN=ganti-dengan-rahasia-token-anda

# Telegram Bot (Kosongkan jika ingin mode headless/API WSS saja)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Node Agent Configuration (Jika node dijalankan mandiri)
NODE_ID=junin
HUB_URL=ws://127.0.0.1:8765
AUDIT_PATH=./audit-junin.jsonl

# LLM Gateway (Opsional untuk node jika menggunakan mode AI Tool Calling)
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://gateway.asteria.im/v1
OPENAI_MODEL=ag/gemini-3.8-flash
